(set-logic QF_LIA)

(declare-const x11 Int)
(declare-const x12 Int)
(declare-const x13 Int)
(declare-const x14 Int)
(declare-const x21 Int)
(declare-const x22 Int)
(declare-const x23 Int)
(declare-const x24 Int)
(declare-const x31 Int)
(declare-const x32 Int)
(declare-const x33 Int)
(declare-const x34 Int)
(declare-const x41 Int)
(declare-const x42 Int)
(declare-const x43 Int)
(declare-const x44 Int)

; Domeni 1..4 i all_different po vrstama i kolonama
(assert (<= 1 x11 4))
(assert (<= 1 x12 4))
(assert (<= 1 x13 4))
(assert (<= 1 x14 4))
(assert (<= 1 x21 4))
(assert (<= 1 x22 4))
(assert (<= 1 x23 4))
(assert (<= 1 x24 4))
(assert (<= 1 x31 4))
(assert (<= 1 x32 4))
(assert (<= 1 x33 4))
(assert (<= 1 x34 4))
(assert (<= 1 x41 4))
(assert (<= 1 x42 4))
(assert (<= 1 x43 4))
(assert (<= 1 x44 4))
(assert (distinct x11 x12 x13 x14))
(assert (distinct x21 x22 x23 x24))
(assert (distinct x31 x32 x33 x34))
(assert (distinct x41 x42 x43 x44))
(assert (distinct x11 x21 x31 x41))
(assert (distinct x12 x22 x32 x42))
(assert (distinct x13 x23 x33 x43))
(assert (distinct x14 x24 x34 x44))

; Broj vidljivih nebodera sa jedne strane
(define-fun visible ((a Int) (b Int) (c Int) (d Int)) Int
  (+ 1
     (ite (> b a) 1 0)
     (ite (and (> c a) (> c b)) 1 0)
     (ite (and (> d a) (> d b) (> d c)) 1 0)))

; levo
(assert (= (visible x11 x12 x13 x14) 2))
(assert (= (visible x21 x22 x23 x24) 3))
(assert (= (visible x31 x32 x33 x34) 1))
(assert (= (visible x41 x42 x43 x44) 2))
; desno
(assert (= (visible x14 x13 x12 x11) 3))
(assert (= (visible x24 x23 x22 x21) 1))
(assert (= (visible x34 x33 x32 x31) 2))
(assert (= (visible x44 x43 x42 x41) 2))
; gore
(assert (= (visible x11 x21 x31 x41) 3))
(assert (= (visible x12 x22 x32 x42) 1))
(assert (= (visible x13 x23 x33 x43) 2))
(assert (= (visible x14 x24 x34 x44) 2))
; dole
(assert (= (visible x41 x31 x21 x11) 2))
(assert (= (visible x42 x32 x22 x12) 3))
(assert (= (visible x43 x33 x23 x13) 1))
(assert (= (visible x44 x34 x24 x14) 3))

(check-sat)
(get-value (x11 x12 x13 x14 x21 x22 x23 x24 x31 x32 x33 x34 x41 x42 x43 x44))
(exit)